# ==============================================================================
# OTSI Video Intelligence Engine (VIE v3) — Environment Variables Template
# Copy this file to .env and configure values for your environment.
# Never commit .env with real credentials.
# ==============================================================================

# Node / API Service Configuration
NODE_ENV=development
OTSI_VIE_PORT=4320
OTSI_VIE_LOG_LEVEL=warn
OTSI_VIE_STORAGE_DIR=.local/storage
OTSI_VIE_PUBLIC_ORIGIN=http://127.0.0.1:4310

# Database Configuration (MySQL 8.4)
# Least-privilege application runtime user
OTSI_VIE_DB_DSN=mysql://otsi_app:YOUR_APP_PASSWORD@127.0.0.1:3508/otsi_owner_vie
# Root / Admin connection for running migrations (tools/db/migrate.py)
OTSI_VIE_ROOT_DSN=mysql://root:YOUR_ROOT_PASSWORD@127.0.0.1:3508/otsi_owner_vie

# Authentication (RS256 JWT)
# In local development, the local auth issuer creates ephemeral keys automatically.
# In production, provide the JWKS or PEM public key and OIDC configuration.
OTSI_VIE_JWT_ISSUER=https://vie.otsi.cc/
OTSI_VIE_JWT_AUDIENCE=otsi-vie-api
OTSI_VIE_JWT_PUBLIC_KEY_PEM=YOUR_PUBLIC_KEY_PEM_HERE
OTSI_VIE_JWT_PRIVATE_KEY_PEM=YOUR_PRIVATE_KEY_PEM_HERE

# Outbox & Background Processing
OTSI_VIE_OUTBOX_POLL_MS=500
OTSI_VIE_DISPATCHER_ENABLED=true

# Python Worker Configuration
WORKER_CONCURRENCY=2
WORKER_DEVICE=CPU
OPENVINO_DEVICE=CPU
FFMPEG_BINARY=ffmpeg

# Web Client Configuration (Next.js)
NEXT_PUBLIC_API_URL=/api
PORT=4310
HOST=127.0.0.1
