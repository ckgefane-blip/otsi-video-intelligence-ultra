# all package caches stay on D: (workspace rule: nothing on C:)
store-dir=D:/OTSI-Workspace/_tmp/pnpm-store
cache-dir=D:/OTSI-Workspace/_tmp/pnpm-cache
save-exact=true
auto-install-peers=true
node-linker=hoisted
# node-linker=hoisted: a real flat node_modules, no symlinks. The pnpm
# default (symlinked) layout breaks the Windows build two ways: the Next.js
# standalone build creates symlinks in .next/standalone, which Windows
# refuses without Developer Mode (EPERM), and electron-builder drops the
# transitive dependencies that exist only inside .pnpm/ when it copies the
# standalone tree as extraResources, so the packaged web server would die
# with Cannot find module at runtime. Hoisted fixes both, and Developer
# Mode is not needed for the build. (Audit, 2026-11-11.)
