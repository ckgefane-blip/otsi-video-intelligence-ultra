{
  "name": "@otsi-vie/api",
  "version": "0.1.0",
  "private": true,
  "description": "OTSI VIE v2 API (NestJS + Fastify). All tenant and entitlement decisions are made here.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:outbox-dispatcher": "node dist/workers/outbox-dispatcher.js",
    "bootstrap-owner": "node dist/cli/bootstrap-owner.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.0.11",
    "@nestjs/core": "11.0.11",
    "@nestjs/platform-fastify": "11.0.11",
    "@otsi-vie/contracts": "workspace:*",
    "@simplewebauthn/server": "14.1.0",
    "fastify": "5.2.1",
    "jose": "5.9.6",
    "mysql2": "3.12.0",
    "playwright-core": "1.49.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "uuid": "11.0.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@swc/core": "1.10.1",
    "@types/node": "22.10.2",
    "@types/qrcode": "1.5.5",
    "typescript": "5.6.3",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.8"
  }
}
